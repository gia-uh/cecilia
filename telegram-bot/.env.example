# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LMStudio API Configuration
# Default: http://localhost:1234/v1
# Change this if LMStudio is running on a different port
LMSTUDIO_API_URL=http://localhost:1234/v1
# Model identifiers (chat + embeddings)
LMSTUDIO_MODEL=cecilia-2b-instruct-v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# BeaverDB Configuration
# Default database file is created in the repo root
# BEAVER_DB_PATH=beaver.db
# Separate DB for RAG vectors
# RAG_BEAVER_DB_PATH=rag.db

# RAG Configuration
# Name of the BeaverDB collection for vector search
# RAG_COLLECTION_NAME=cuban_rag
# Number of vector neighbors to retrieve
# RAG_TOP_K=3
# Minimum similarity score to accept a doc
# RAG_MIN_SCORE=0.6
# Batch size for seeding embeddings
# RAG_BATCH_SIZE=32
# Enable/disable RAG
# ENABLE_RAG=true
# Path to seed data for RAG
# RAG_DATA_PATH=data/cuban_data_v2.json
